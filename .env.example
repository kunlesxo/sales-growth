# Copy this file to .env for LOCAL use only (it is git-ignored).
# On Railway, add the same names under your web service > Variables. Never commit real values.

# ---- Django ----
DJANGO_SECRET_KEY=replace-with-a-long-random-string-of-50-plus-characters
DJANGO_DEBUG=1
# Railway fills this in for you when you enable a public domain:
RAILWAY_PUBLIC_DOMAIN=

# ---- Database (Railway: reference your Postgres service, e.g. ${{Postgres.DATABASE_URL}}) ----
# Local default is SQLite, so you can leave this empty.
DATABASE_URL=

# ---- Paystack (TEST keys first: sk_test_...) ----
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ghana: leave empty or 0 to keep GHS off. Enter pesewas (GH₵500 = 50000) only after you confirm GHS on the Paystack page.
PRICE_GHS_PESEWAS=

# ---- Telegram (bot token from BotFather; the existing @Salesgrowthacademyaccessbot) ----
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
# Any long random string. The webhook is rejected unless Telegram sends it back.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Chat IDs are already set in config/settings.py. Set these only if they ever change.
# CLASSROOM_CHAT_ID=-1004498169669
# DISCUSSION_CHAT_ID=-1004365675295

# ---- Admin login (created or updated on every deploy) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-long-unique-password

# ---- Support fallback (your WhatsApp link, https only) ----
SUPPORT_WHATSAPP_URL=https://wa.me/234XXXXXXXXXX

# Optional
# EXTRA_ALLOWED_HOSTS=your-custom-domain.com
# WEB_CONCURRENCY=3
